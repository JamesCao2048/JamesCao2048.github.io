---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found" noindex
  ><section class="empty-state not-found">
    <p class="eyebrow">404 / Page not found</p><h1>That page isn’t here.</h1><p>
      The address may have changed. You can explore my current work or head back
      to the homepage.
    </p><div class="hero-actions">
      <a class="button primary" href="/">Go home </a><a
        class="button secondary"
        href="/projects/">View projects</a
      >
    </div>
  </section></Layout
>
